{
  "name": "quote-intake-agent",
  "version": "0.1.0",
  "private": true,
  "description": "An AI intake agent for a home-services business: turns inbound quote requests into routed, human-approved reply drafts, with deterministic guardrails and a labelled eval suite.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "intake": "node --env-file-if-exists=.env src/cli.ts",
    "eval": "node --env-file-if-exists=.env evals/run.ts",
    "eval:replay": "node evals/run.ts --replay evals/results/latest.json --out evals/results/latest.md",
    "eval:heldout": "node --env-file-if-exists=evals/heldout.env evals/run.ts --replay evals/results/heldout.json --out evals/results/heldout.md",
    "eval:faults": "node evals/faults.ts evals/results/latest.json",
    "eval:offline": "node evals/offline.ts",
    "test": "node --test tests/*.test.ts",
    "check": "tsc --noEmit && node --test tests/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
